# Copy to .env to configure the local Docker Compose demo.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MISSION_CONTROL_API_PORT=8003
MISSION_CONTROL_DASHBOARD_PORT=8081
MISSION_CONTROL_RETENTION_DAYS=30
MISSION_CONTROL_CYCLE_SECONDS=60
MISSION_CONTROL_WINDOW_SECONDS=20
MISSION_CONTROL_WINDOW_CAPACITY_BYTES=4096
MISSION_CONTROL_TRANSFER_RATE_BYTES_PER_SECOND=512
INSTALL_ML_RUNTIME=true

# The optional conversation adapter remains off unless explicitly enabled.
CHATBOT_CONVERSATION_ENABLED=false
CHATBOT_LOCAL_MODEL_URL=http://ollama:11434
CHATBOT_LOCAL_MODEL_NAME=llama3.2:3b
CHATBOT_CONVERSATION_LANGUAGE=en

# Optional; pin to an approved Ollama image before a pilot.
OLLAMA_IMAGE=ollama/ollama:0.40.16
