# Copy to .env to configure Docker Compose. Local conversation remains off.
CHATBOT_CONVERSATION_ENABLED=true
CHATBOT_LOCAL_MODEL_URL=http://ollama:11434
CHATBOT_LOCAL_MODEL_NAME=llama3.2:3b
CHATBOT_CONVERSATION_LANGUAGE=en

# Optional; pin to an approved Ollama image before a pilot.
OLLAMA_IMAGE=ollama/ollama:0.40.16
